<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smppulse.ui.controller.MessageLogController"
      spacing="8">
    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="filterField" promptText="Filter messages..." prefWidth="250"/>
        <ComboBox fx:id="directionFilter" prefWidth="120">
            <items>
                <javafx.collections.FXCollections fx:factory="observableArrayList">
                    <String fx:value="All"/>
                    <String fx:value="OUT"/>
                    <String fx:value="IN"/>
                    <String fx:value="ERR"/>
                </javafx.collections.FXCollections>
            </items>
        </ComboBox>
        <Region HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="autoScrollCheck" text="Auto-scroll" selected="true"/>
        <Button text="Clear" styleClass="button" onAction="#handleClear"/>
        <Label fx:id="countLabel" text="0 messages" style="-fx-text-fill: #888898;"/>
    </HBox>

    <!-- Message Table -->
    <TableView fx:id="messageTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="160"/>
            <TableColumn fx:id="directionColumn" text="Dir" prefWidth="50"/>
            <TableColumn fx:id="pduTypeColumn" text="PDU Type" prefWidth="100"/>
            <TableColumn fx:id="messageIdColumn" text="Message ID" prefWidth="120"/>
            <TableColumn fx:id="sourceColumn" text="Source" prefWidth="120"/>
            <TableColumn fx:id="destColumn" text="Destination" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
